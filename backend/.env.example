# Server (set NODE_ENV=production & TRUST_PROXY=1 when behind Vercel/Nginx/PaaS proxy)
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=0
APP_ORIGIN=http://localhost:5173
OFFICE_TIMEZONE=Asia/Jakarta

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/magang_presensi?schema=public

# Security Secrets (replace with 32+ byte random hex/base64 values in .env)
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET
EMBEDDING_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_32_BYTE_KEY

# Internal Face Service
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_TOKEN=REPLACE_WITH_INTERNAL_SHARED_TOKEN

# Private Storage (outside public webroot)
EVIDENCE_STORAGE_DIR=./storage/evidence

# Optional SMTP (required if email-based password reset links should be delivered by email)
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Presensi Magang <no-reply@example.id>
