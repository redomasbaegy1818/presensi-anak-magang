  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "db:verify": "tsx src/scripts/verifyDatabase.ts",
    "db:seed-admin": "tsx src/scripts/seedAdmin.ts",
    "test:admin-auth": "tsx src/scripts/testAdminAuth.ts",
    "test:participant-reg": "tsx src/scripts/testParticipantRegistration.ts",
    "test:attendance": "tsx src/scripts/testAttendanceSystem.ts",
    "test:admin-dashboard": "tsx src/scripts/testAdminDashboard.ts",
    "test:admin-participants": "tsx src/scripts/testAdminParticipants.ts",
    "test:admin-attendance": "tsx src/scripts/testAdminAttendance.ts",
    "test:admin-reports": "tsx src/scripts/testAdminReports.ts",
    "test:admin-settings": "tsx src/scripts/testAdminSettings.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.7",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0"
  }
}